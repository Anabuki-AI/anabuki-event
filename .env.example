# PostgreSQL / backend
POSTGRES_USER=anabuki
POSTGRES_PASSWORD=anabuki
JDBC_URL=jdbc:postgresql://localhost:5432/anabuki_event
DB_POOL_SIZE=10
PORT=8080

# Nuxt
NUXT_BACKEND_BASE_URL=http://localhost:8080
NUXT_PUBLIC_API_BASE=/api

# 公開URL / OAuth callback URL（.envで管理）
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3000/admin
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# 個別の管理者メールアドレス（カンマ区切り。Google Workspaceドメイン指定は不可）
ADMIN_EMAIL_ALLOWLIST=your-email@example.com

# C is re-evaluated from this allowlist on every authenticated request.
# Do not use a physical device identifier or fingerprint here.
