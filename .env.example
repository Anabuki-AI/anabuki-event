# PostgreSQL / backend (Rails)
POSTGRES_USER=anabuki
POSTGRES_PASSWORD=anabuki
RAILS_ENV=development
RAILS_MAX_THREADS=5
DATABASE_URL=postgresql://anabuki:anabuki@localhost:5433/anabuki_event_rails_development
PORT=8080
QUE_WORKER_COUNT=3

# Google OAuth (実値は .env のみに記載し、コミットしない)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
ADMIN_EMAIL_ALLOWLIST=

# Nuxt
NUXT_BACKEND_BASE_URL=http://localhost:8080
NUXT_PUBLIC_API_BASE=/api
